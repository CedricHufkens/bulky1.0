@model List<Product>
<div class="Container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary"> Producten List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create new Product
            </a>
        </div>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    Titel
                </th>
                <th>
                    Author
                </th>
                <th>
                    ISBN

                </th>
                <th>
                    Price
                </th>
                <th>
                    Category
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderBy(u => u.Id))
            {
                <tr>
                    <td>@item.Title</td>
                    <td>
                        @item.Author

                    </td>
                    <td>
                        @item.ISBN

                    </td>
                    <td>
                        @item.Price

                    </td>
                    <td>
                        @item.Category

                    </td>

                    <td>
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary form-control">
                            <i class="bi bi-pencil-square"></i> EDIT
                        </a>
                    </td>
                    <td>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger form-control">
                            <i class="bi bi-trash3"></i> DELETE
                        </a>
                    </td>
                </tr>

            }
        </tbody>

    </table>
<div>