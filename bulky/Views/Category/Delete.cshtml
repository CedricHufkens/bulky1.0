@model Category
<form method="post">
    <div class="border p-3 mt-4">
        <h2 class="text-primary">Delete Category</h2>
        <hr/>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3 row">
        <label asp-for="Name"></label>
        <input asp-for="Name" readonly class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3 row">
        <label asp-for="DisplayOrder"  class="p-0"></label>
        <input asp-for="DisplayOrder" readonly class="form-control" />
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>

    </div>
    <div class="row">
        <div class="col-lg-6 col-md-3">
            <button type="submit" class="btn btn-danger  form-control"  form-control">DELETE </button>
        </div>
        <div class="col-lg-6 col-md-3">
            <a asp-controller="category" asp-action="Index" class="btn btn-secondary form-control">
                Back to list
            </a>
        </div>
    </div>

</form>